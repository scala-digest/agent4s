#!/usr/bin/env bash
# If executed by a non-bash shell, re-exec with bash.
# When eval'd (e.g. zsh eval), $0 is the shell binary — fall through
# since the script is POSIX-compatible.
if [ -z "${BASH_VERSION:-}" ] && [ -f "$0" ]; then
  exec bash "$0" "$@"
fi
set -euo pipefail

EXPECTED_VERSION="0.6.0"
REPO="scala-digest/agent4s"

# Expected SHA-256 checksums for each artifact (updated each release alongside EXPECTED_VERSION)
CHECKSUM_scalex_macos_arm64="fe2d4f115e1e1234a818897d82a43785946c0037d42a99feac17bda2e14d0647"
CHECKSUM_scalex_macos_x64="a1ae49c97e85032cb8ce7baa0af343e25cea5dedda156305657687085933c9b9"
CHECKSUM_scalex_linux_x64="d88d62db8e93d8f21ef66764264a0df56f758f00cbae6e46f0a54b7c6bde04c4"
CHECKSUM_scalex_windows_x64="5a148252071d320fc76a2c010ffdfc047cbb5acd40121b76765047638e3a9f2c"

# Cache location: follow XDG spec
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agent4s"

# Detect platform → artifact name
OS=$(uname -s); ARCH=$(uname -m)
case "$OS-$ARCH" in
  Darwin-arm64)  ARTIFACT="scalex-macos-arm64" ;;
  Darwin-x86_64) ARTIFACT="scalex-macos-x64" ;;
  Linux-x86_64)  ARTIFACT="scalex-linux-x64" ;;
  MINGW*-x86_64|MSYS*-x86_64|CYGWIN*-x86_64) ARTIFACT="scalex-windows-x64.exe" ;;
  *) echo "agent4s: unsupported launcher platform $OS-$ARCH. See https://github.com/${REPO}/releases for native downloads." >&2; exit 1 ;;
esac

# Binary path includes version (like Mill's ~/.cache/mill/download/1.1.3-native-mac-aarch64)
BINARY="$CACHE_DIR/$EXPECTED_VERSION-$ARTIFACT"

# Fast path: binary exists, non-empty, executable → exec immediately
if [ -s "$BINARY" ] && [ -x "$BINARY" ]; then
  exec "$BINARY" "$@"
fi

# Download
echo "agent4s: downloading v${EXPECTED_VERSION} for ${OS}-${ARCH}..." >&2
mkdir -p "$CACHE_DIR"
TMP=$(mktemp "$CACHE_DIR/scalex-temp.XXXXXX")
trap 'rm -f "$TMP"' EXIT

BASE_URL="https://github.com/${REPO}/releases/download/v${EXPECTED_VERSION}"

curl -fsSL --retry 3 -o "$TMP" "${BASE_URL}/${ARTIFACT}" || {
  echo "agent4s: download failed. Visit https://github.com/${REPO}/releases" >&2
  exit 1
}

# Verify checksum
artifact_base=${ARTIFACT%.exe}
checksum_var="CHECKSUM_${artifact_base//-/_}"
expected_hash="${!checksum_var}"
if command -v sha256sum >/dev/null 2>&1; then
  actual_hash=$(sha256sum -b < "$TMP" | awk '{print $1}')
else
  actual_hash=$(shasum -a 256 -b < "$TMP" | awk '{print $1}')
fi
if [[ "$actual_hash" != "$expected_hash" ]]; then
  echo "agent4s: checksum verification failed for $ARTIFACT" >&2
  echo "  expected: $expected_hash" >&2
  echo "  actual:   $actual_hash" >&2
  exit 1
fi

# Install atomically
chmod +x "$TMP"
mv "$TMP" "$BINARY"
trap - EXIT

# macOS: remove quarantine
[ "$OS" = "Darwin" ] && xattr -d com.apple.quarantine "$BINARY" 2>/dev/null || true

echo "agent4s: installed native release v${EXPECTED_VERSION}" >&2
exec "$BINARY" "$@"
